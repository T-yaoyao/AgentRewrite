# This is a configuration file for environment variables used in the project.

# API keys and model configurations, since there are multiple models used in the project,
# we define them here for easy access and modification.
# Note: Replace [your_api_key_here] and [your_model_url_here] with actual values.
############ Example ############ 
# REASONING_MODEL_API_KEY=sk-123456
# REASONING_MODEL=deepseek-r1 (we set the default model in all agent configurations as shown below)
# REASONING_MODEL_URL=https://api.deepseek.com/v1
############ Example ############ 

REASONING_MODEL_API_KEY=a8286e46-ba5d-4ea2-a11c-b477a7e75219
REASONING_MODEL=ep-20260309181212-22b58
REASONING_MODEL_URL=https://ark.cn-beijing.volces.com/api/v3

DECISION_MODEL_API_KEY=sk-MnAgkjUYt57jfJawM1Q7BAm1VBdwXI3OJCG22rMEp0Rvxgjo
DECISION_MODEL=claude-sonnet-4-5-20250929
DECISION_MODEL_URL=https://jeniya.cn/v1

REWRITE_MODEL_API_KEY=a8286e46-ba5d-4ea2-a11c-b477a7e75219
REWRITE_MODEL=ep-20260309181212-22b58
REWRITE_MODEL_URL=https://ark.cn-beijing.volces.com/api/v3

SEMANTIC_CHECK_MODEL_API_KEY=sk-MnAgkjUYt57jfJawM1Q7BAm1VBdwXI3OJCG22rMEp0Rvxgjo
SEMANTIC_CHECK_MODEL=claude-sonnet-4-5-20250929-thinking
SEMANTIC_CHECK_MODEL_URL=https://jeniya.cn/v1

# Database configuration
# These variables are used to connect to the PostgreSQL database.
# Ensure that the database is running and accessible at the specified host and port.
# Note: Replace the values with your actual database credentials.
############ Example ############ 
# DB_NAME=tpch_s10
# DB_USER=postgres
# DB_PASSWORD=knob
# DB_HOST=localhost
# DB_PORT=5432
############ Example ############ 

DB_NAME=tpch
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432

# Project root directory
############# Example ############
# PROJECT_ROOT=/root/syy/QUITE
############# Example ############

PROJECT_ROOT=/root/AgentRewrite

# 可选：Embedding（sentence-transformers / Hugging Face Hub）
# 已有 models_cache 时默认从本地 snapshot 加载，无需联网。
# 仅离线且本地无模型时：先在有网机器下载，或设置 ST_EMBEDDING_MODEL_PATH 指向含 config.json 与权重的目录。
# ST_EMBEDDING_MODEL_PATH=
# ST_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=1