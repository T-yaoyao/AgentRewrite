# This is a configuration file for environment variables used in the project.

# API keys and model configurations, since there are multiple models used in the project,
# we define them here for easy access and modification.
# Note: Replace [your_api_key_here] and [your_model_url_here] with actual values.
############ Example ############ 
# REASONING_MODEL_API_KEY=sk-123456
# REASONING_MODEL=deepseek-r1 (we set the default model in all agent configurations as shown below)
# REASONING_MODEL_URL=https://api.deepseek.com/v1
############ Example ############ 

REASONING_MODEL_API_KEY=sk-d676237d0a994d70accf6af4e6edcc57
REASONING_MODEL=deepseek-v3.2
REASONING_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

DECISION_MODEL_API_KEY=sk-d676237d0a994d70accf6af4e6edcc57
DECISION_MODEL=deepseek-v3.2
DECISION_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

ASSISTANT_MODEL_API_KEY=sk-d676237d0a994d70accf6af4e6edcc57
ASSISTANT_MODEL=deepseek-v3.2
ASSISTANT_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode

REWRITE_MODEL_API_KEY=sk-d676237d0a994d70accf6af4e6edcc57
REWRITE_MODEL=deepseek-v3.2
REWRITE_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Database configuration
# These variables are used to connect to the PostgreSQL database.
# Ensure that the database is running and accessible at the specified host and port.
# Note: Replace the values with your actual database credentials.
############ Example ############ 
# DB_NAME=tpch_s10
# DB_USER=postgres
# DB_PASSWORD=knob
# DB_HOST=localhost
# DB_PORT=5432
############ Example ############ 

DB_NAME=tpch
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432

# Project root directory
############# Example ############
# PROJECT_ROOT=/root/syy/QUITE
############# Example ############

PROJECT_ROOT=/root/AgentRewrite