# Database configuration
# These variables are used to connect to the PostgreSQL database.
# Ensure that the database is running and accessible at the specified host and port.
# Note: Replace the values with your actual database credentials.
############ Example ############ 
# DB_NAME=tpch_s10
# DB_USER=postgres
# DB_PASSWORD=knob
# DB_HOST=localhost
# DB_PORT=5432
############ Example ############
DB_NAME=tpch
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432

# Project root directory
############# Example ############
# PROJECT_ROOT=/root/syy/QUITE
############# Example ############

PROJECT_ROOT=/root/AgentRewrite

# 可选：Embedding（sentence-transformers / Hugging Face Hub）
# 已有 models_cache 时默认从本地 snapshot 加载，无需联网。
# 仅离线且本地无模型时：先在有网机器下载，或设置 ST_EMBEDDING_MODEL_PATH 指向含 config.json 与权重的目录。
# ST_EMBEDDING_MODEL_PATH=
# ST_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=1